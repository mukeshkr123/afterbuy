{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "acme-local-api",
  "main": "src/index.ts",
  // Keep this in sync with infra/env.ts COMPATIBILITY_DATE and SST worker transforms.
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "APP_STAGE": "local",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:8081",
    "REMINDER_QUEUE_NAME": "local-reminder-queue",
    "REMINDER_DLQ_NAME": "local-reminder-dlq",
    "DAILY_CRON_EXPRESSION": "0 2 * * *",
    "CLERK_ISSUER": "https://talented-mayfly-77.clerk.accounts.dev",
    "CLERK_JWKS_URL": "https://talented-mayfly-77.clerk.accounts.dev/.well-known/jwks.json",
    "CLERK_ALLOWED_AZP": "http://localhost:8081,http://localhost:5173",
    "CLERK_WEBHOOK_SECRET": "",
    "RATE_LIMIT_ENABLED": "true",
    "RATE_LIMIT_WINDOW_SECONDS": "60",
    "RATE_LIMIT_MAX_REQUESTS": "120",
    "LOCAL_AUTH_ENABLED": "false",
    "LOCAL_AUTH_TOKEN": "local-dev-token",
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Placeholder only: SST creates real D1 databases during deploy.
      "database_name": "SST_CREATES_THIS_DATABASE",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "sst-creates-this-bucket",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "00000000000000000000000000000000",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "REMINDER_QUEUE",
        "queue": "local-reminder-queue",
      },
      {
        "binding": "REMINDER_DLQ",
        "queue": "local-reminder-dlq",
      },
    ],
    "consumers": [
      {
        "queue": "local-reminder-queue",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "local-reminder-dlq",
      },
    ],
  },
  "triggers": {
    "crons": ["0 2 * * *"],
  },
}
