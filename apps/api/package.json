{
  "name": "@acme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "dev": "wrangler dev --config wrangler.jsonc --local",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.config.unit.ts",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typegen": "wrangler types src/worker-configuration.d.ts --config wrangler.jsonc"
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "@acme/shared": "workspace:*",
    "@asteasolutions/zod-to-openapi": "9.0.0",
    "@hono/zod-openapi": "1.5.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.30",
    "jose": "5.10.0",
    "svix": "1.41.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@cloudflare/workers-types": "5.20260718.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
