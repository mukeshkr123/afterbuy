    "@tanstack/react-query-persist-client": "5.95.2",
    "expo": "57.0.7",
    "expo-constants": "18.0.9",
    "expo-linking": "8.0.10",
    "expo-router": "6.0.12",
    "expo-secure-store": "15.0.7",
