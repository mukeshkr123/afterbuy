{
  "name": "@acme/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "prebuild": "pnpm --filter @acme/shared --filter @acme/db build",
    "build": "echo 'use expo prebuild → eas build for native'",
    "dev": "expo start --port 8081",
    "start": "expo start --port 8081",
