{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "jsx": "react-native",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@acme/shared": ["../../packages/shared/dist/index.d.ts"],
      "@acme/db": ["../../packages/db/dist/index.d.ts"],
      "@/*": ["./src/*"],
      "*": ["./*"]
    },
    "types": ["react-native"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
