{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": false,
    "outDir": "dist/types",
    "rootDir": "src",
    "types": ["vite/client"]
  },
  "include": [
    "../../node_modules/@cloudflare/workers-types/index.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["dist", "**/*.test.tsx"],
  "references": [{ "path": "../../packages/shared" }]
}
