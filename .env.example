# Local defaults only. Production runtime values belong in Cloudflare Worker
# Variables & Secrets. These Cloudflare credentials are only for local admin
# commands such as migrations, backups, and secret setup.

ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# Clerk auth — vars are public; the webhook secret is bound via sst.Secret.
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_ALLOWED_AZP=

# Local Wrangler admin values; do not commit real values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PRODUCTION_D1_DB_NAME=acme-prod-d1
