{
  "name": "acme-cloudflare-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "api:dev": "pnpm --filter @acme/api dev",
    "api:local:init": "tsx scripts/api-local-init.ts",
    "api:openapi": "tsx scripts/write-openapi.ts && prettier --write docs/openapi.json",
    "bootstrap:github-env": "tsx scripts/bootstrap-github-env.ts",
    "bootstrap:mobile-release": "tsx scripts/bootstrap-mobile-release.ts",
    "build": "pnpm -r build",
    "ci": "pnpm build && pnpm typecheck && pnpm lint && pnpm verify:ids && pnpm verify:skills && pnpm verify:template && pnpm verify:migrations && pnpm api:openapi && echo 'Tests skipped per repo policy'",
    "db:backup": "tsx scripts/d1-backup.ts",
    "db:restore": "tsx scripts/d1-restore.ts",
    "db:restore-drill": "tsx scripts/d1-restore-drill.ts",
    "db:verify-restore": "tsx scripts/d1-verify.ts",
    "deploy": "sst deploy --stage prod",
    "deploy:stage": "sst deploy --stage",
    "dev": "pnpm --filter @acme/api dev",
    "mobile:dev": "pnpm --filter @acme/mobile dev",
    "mobile:start": "pnpm --filter @acme/mobile start",
    "mobile:android": "pnpm --filter @acme/mobile android",
    "mobile:ios": "pnpm --filter @acme/mobile ios",
    "mobile:web": "pnpm --filter @acme/mobile web",
    "format": "prettier --write .",
    "lint": "eslint eslint.config.js && prettier --check .",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "skills:install": "tsx scripts/install-agent-skills.ts",
    "skills:verify": "tsx scripts/verify-agent-skills.ts",
    "test": "pnpm -r --if-present test && vitest run",
    "typecheck": "tsc -b --force && tsc -p tsconfig.sst.json --noEmit",
    "validate:config": "tsx scripts/validate-config.ts",
    "verify:ids": "tsx scripts/verify-no-hardcoded-ids.ts",
    "verify:migrations": "tsx scripts/verify-migrations.ts",
    "verify:skills": "tsx scripts/verify-agent-skills.ts",
    "verify:template": "tsx scripts/verify-template.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@cloudflare/workers-types": "5.20260718.1",
    "@eslint/js": "10.0.1",
    "@pulumi/cloudflare": "6.18.0",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "sst": "3.19.3",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  }
}
